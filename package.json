{
  "name": "brasta-online",
  "version": "0.5.0",
  "private": true,
  "description": "Server-authoritative online Brasta for Vercel WebSockets + Redis",
  "scripts": {
    "sync:engine": "node scripts/sync-server-engine.mjs",
    "build:client": "tsc -p tsconfig.client.json && tsc -p tsconfig.tests.json",
    "build": "npm run sync:engine && npm run build:client && next build",
    "start": "next start",
    "test:rules": "npm run build:client && node public/dist/tests-bundle.js"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@vercel/functions": "latest",
    "ioredis": "^5.4.1",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "ws": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "latest",
    "typescript": "^5.8.3"
  }
}
