{
  "name": "brasta-online",
  "version": "0.4.0",
  "private": true,
  "description": "Server-authoritative online Brasta for Vercel WebSockets + Redis",
  "scripts": {
    "sync:engine": "node scripts/sync-server-engine.mjs",
    "build:client": "tsc -p tsconfig.json && tsc -p tsconfig.tests.json",
    "build": "npm run extract:client && npm run sync:engine && npm run build:client && next build",
    "start": "next start",
    "test:rules": "npm run extract:client && npm run build:client && node public/dist/tests-bundle.js",
    "extract:client": "node scripts/extract-client.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@vercel/functions": "latest",
    "ioredis": "^5.4.1",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "ws": "latest",
    "adm-zip": "^0.5.16"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/ws": "latest",
    "typescript": "^5.8.3",
    "@types/adm-zip": "latest"
  }
}
