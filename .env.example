REDIS_URL=rediss://default:password@example.upstash.io:6379

# Optional: point the browser at a standalone realtime server.
# Leave blank/unset to keep using the current same-origin /api/ws endpoint.
# Example staging value: https://your-service.up.railway.app/ws
NEXT_PUBLIC_BRASTA_REALTIME_URL=

# Standalone realtime server settings (Railway injects PORT automatically).
BRASTA_WS_PATH=/ws
BRASTA_REQUIRE_REDIS=true

# Supabase project settings (Project Settings > API / Connect)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only key used by tournament, friends, ranking, and experience APIs.
# Never prefix this with NEXT_PUBLIC_ or expose it to browser code.
SUPABASE_SECRET_KEY=sb_secret_your_key

# Comma-separated Brasta admin account allowlist. The same allowlist controls
# Live Traffic and the /admin/tournaments scheduling console.
BRASTA_ADMIN_EMAILS=admin@example.com
BRASTA_ADMIN_USER_IDS=
